# ─────────────────────────────────────────────────────────────────────────────
# .env.example — environment-variable reference for local development & Render.
#
# Copy to .env for local development:
#   cp .env.example .env
#
# For Render: set each variable in the Render Dashboard under
#   Environment → Environment Variables  (never commit real values).
#
# Variables prefixed VITE_ are embedded into the frontend bundle at build time.
# All other variables are server-side only and never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (frontend — safe to embed in bundle) ─────────────────────────────
# Get these from Firebase Console → Project Settings → General → Your apps → Web app.
# These are NOT secrets — security is enforced via Firebase Security Rules.
#
# HOW TO SET UP:
# 1. Go to https://console.firebase.google.com → New project
# 2. Authentication → Sign-in method → Google → Enable
# 3. Realtime Database → Create database → Start in locked mode
# 4. Project Settings → Your apps → Add web app → Copy config values below
# 5. Add your site domain to: Authentication → Settings → Authorized domains
# 6. Set Realtime Database rules (see firebase-rules.md in this repo)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Google OAuth 2.0 (legacy — used only if Render web service with Neon DB) ──
# Google OAuth 2.0 Web Client ID — embedded in the frontend bundle so the
# Google Identity Services script can initialize One Tap and the sign-in button.
VITE_GOOGLE_CLIENT_ID=

# EmailJS browser integration values — safe to embed in the frontend bundle.
# Never put a private API key or email-provider password here.
# Get these from https://www.emailjs.com → Email Services / Templates / Account.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ── Server-side secrets (runtime only — never exposed to the browser) ─────────
# The following are ONLY needed if deploying as a full Render web service
# (with the Node.js API server, Neon DB, and Telegram webhook).
# For a pure static site deploy, these are NOT needed.

# Google OAuth 2.0 Client ID used for server-side token verification.
GOOGLE_CLIENT_ID=

# Full public URL of this Render service (no trailing slash).
APP_BASE_URL=

# Neon PostgreSQL connection string.
DATABASE_URL=

# JWT session signing secret — must be ≥ 32 characters.
# Generate: openssl rand -base64 32
SESSION_SECRET=

# Telegram bot credentials (optional — leave blank to disable Telegram features).
# Create a bot: message @BotFather on Telegram → /newbot
# Get your chat ID: message @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
